*.env.local
*.env.*.local
*.local.env
.env.secret
*.secret

# EXCEPCIÓN EXPLÍCITA: Mantener en el repositorio los ambientes declarados del proyecto
!environments/.env.development
!environments/.env.staging
!environments/.env.production

