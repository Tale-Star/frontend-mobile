# ------------------------------------------------------------------------------
# 1. Flutter, Dart & Herramientas de Compilación
# ------------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
.packages

# Directorios de compilación (raíz y anidados)
/build/
build/
/coverage/
coverage/
**/doc/api/

# Símbolos, logs y mapas de ofuscación de Flutter
app.*.symbols
app.*.map.json
flutter_*.log

# Binarios de empaquetado generados
*.apk
*.aab
*.ipa
*.app
*.xctest

# NOTA OFICIAL SOBRE pubspec.lock:
# Según la documentación oficial de Flutter y Dart, en aplicaciones móviles
# (a diferencia de paquetes o librerías) el archivo pubspec.lock DEBE mantenerse
# en control de versiones para garantizar builds reproducibles e idénticos en CI/CD.

